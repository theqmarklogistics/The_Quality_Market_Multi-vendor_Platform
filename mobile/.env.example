# Copy to `.env` (gitignored). EXPO_PUBLIC_* values are inlined into the app bundle.

# Base URL of the deployed Next.js backend the app calls (no trailing slash).
# Use your machine's LAN IP (not localhost) when testing on a physical device,
# e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL="https://www.thequalitymarket.com"

# Clerk publishable key (same Clerk instance as the web app).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_Y2xlcmsudGhlcXVhbGl0eW1hcmtldC5jb20k"

# Display currency symbol, mirrors web NEXT_PUBLIC_CURRENCY_SYMBOL.
EXPO_PUBLIC_CURRENCY_SYMBOL="RWF"

# Enable Socket.IO realtime (delivery tracking, chat). Requires the backend to run
# via the custom server (node server.js), not Vercel serverless.
EXPO_PUBLIC_SOCKET_ENABLED="true"

# Android Google Maps API key — required by react-native-maps to render the live
# delivery map on Android. Create one in Google Cloud Console (Maps SDK for Android).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="<your-android-maps-api-key>"
