# Copy this file to `.env` and fill in real values. Never commit `.env` (it is gitignored).
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.

# Display currency symbol shown across the storefront.
NEXT_PUBLIC_CURRENCY_SYMBOL="RWF"

# Comma-separated list of admin emails (matched case-insensitively).
ADMIN_EMAIL="admin@example.com"

# Clerk authentication keys (https://dashboard.clerk.com).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="<your-clerk-publishable-key>"
CLERK_SECRET_KEY="<your-clerk-secret-key>"

# Postgres (Supabase). Copy both strings from Supabase → Project → Connect → ORMs → Prisma.
# DATABASE_URL = Transaction pooler (port 6543, PgBouncer) used by the app at runtime.
# DIRECT_URL   = Direct/session connection (port 5432) used by `prisma migrate`.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Inngest (background jobs).
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="<your-inngest-signing-key>"

# ImageKit (media storage / CDN).
IMAGEKIT_PUBLIC_KEY="<your-imagekit-public-key>"
IMAGEKIT_PRIVATE_KEY="<your-imagekit-private-key>"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your-imagekit-id"

# LLM provider (OpenAI-compatible endpoint).
OPENAI_API_KEY="your-llm-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1/"
OPENAI_MODEL="gpt-4o-mini"

# Resend (transactional email).
RESEND_API_KEY="<your-resend-api-key>"
RESEND_FROM_EMAIL="noreply@example.com"

# Public base URL of the app. In production set this to your real origin
# (e.g. https://www.example.com); it also restricts Socket.IO CORS in server.js.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Enable Socket.IO realtime (delivery tracking, chat, notifications).
# Requires running via the custom server (`node server.js` / `npm start`), not Vercel serverless.
# Keep this "false" on Vercel: server.js never runs there, so the client would
# otherwise poll /socket.io forever and 404. HTTP polling fallback covers the features.
NEXT_PUBLIC_SOCKET_ENABLED="false"

# OSRM road-routing server for live delivery ETA + route geometry.
# Defaults to the public demo (https://router.project-osrm.org), which is
# rate-limited and NOT for production. Point this at a self-hosted OSRM instance
# loaded with the Rwanda OSM extract before going live.
OSRM_URL="https://router.project-osrm.org"

# Use OSRM road distances for delivery PRICING (quotes + corridor splits).
# Off by default → pricing uses straight-line (haversine) distance. Only enable
# once OSRM_URL points at a self-hosted instance (the public demo is rate-limited).
DELIVERY_OSRM_PRICING="false"

# Delivery notifications are email-only for now (Resend, configured above).
# SMS is intentionally disabled — leave DELIVERY_SMS_ENABLED unset/false. To turn
# SMS on later, set DELIVERY_SMS_ENABLED="true" and a provider (e.g. PINDO_API_TOKEN).
DELIVERY_SMS_ENABLED="false"

# Max stops per pooled-delivery corridor (one rider's route). A sector with more
# orders is split across several corridors. Defaults to 5.
MAX_STOPS_PER_CORRIDOR="5"

# ── Error monitoring (all optional; see lib/errorReporting.js) ────────────────
# Every uncaught server error (and mobile crash report) is logged as a
# structured SERVER_ERROR JSON line regardless of these settings.
# Webhook to also forward errors to — a Slack/Discord incoming webhook URL works.
# ERROR_WEBHOOK_URL=""
# Email address for error alerts (throttled to 1 per error per 15 min).
# Defaults to the first ADMIN_EMAIL when unset; requires RESEND_API_KEY.
# ERROR_ALERT_EMAIL=""
