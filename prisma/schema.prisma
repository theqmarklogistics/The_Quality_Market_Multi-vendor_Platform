generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["driverAdapters"]
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

// Required for creating a User: id, name, email, image, cart (optional JSON string)
model User {
    id    String @id
    name  String
    email String
    image String
    cart  Json   @default("{}")

    // Relations
    ratings     Rating[]
    Address     Address[]
    store       Store?
    buyerOrders Order[]   @relation("BuyerRelation")
    conversations      ConversationParticipant[]
    sentMessages       Message[]                 @relation("MessageSender")
    returns     Return[]
}

// Required for creating a Product: name, description, mrp, price, images, category, storeId
model Product {
    id          String   @id @default(cuid())
    name        String
    description String
    mrp         Float
    price       Float
    warehouseQuantity Int @default(0)
    images      String[]
    category    String
    inStock     Boolean  @default(true)
    storeId     String
    approvalStatus ProductApprovalStatus @default(PENDING)
    approvalNotes  String?
    approvedBy     String?
    approvedAt     DateTime?
    // Wholesale pricing (optional — unlocked when quantity >= wholesaleMinQty)
    wholesalePrice  Float?
    wholesaleMinQty Int?
    // Shipping dimensions for weight-based cost calculation
    weightKg    Float?
    lengthCm    Float?
    widthCm     Float?
    heightCm    Float?
    importOrigin String?  // "CHINA" | null (local/Rwanda)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations
    store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
    orderItems OrderItem[]
    rating     Rating[]

    @@index([approvalStatus, createdAt])
}

enum ProductApprovalStatus {
    PENDING
    APPROVED
    REJECTED
}

enum OrderStatus {
    ORDER_PLACED
    PROCESSING
    SHIPPED
    DELIVERED
}

enum PaymentMethod {
    STRIPE
    MTN_MOMO
    AIRTEL_MONEY
    BANK_TRANSFER
}

enum PaymentStatus {
    PENDING
    PAID
    FAILED
    EXPIRED
    CANCELLED
}

enum PaymentProofStatus {
    NOT_SUBMITTED
    SUBMITTED
    APPROVED
    REJECTED
}

enum ConversationTargetType {
    ADMIN
    STORE
}

enum PayoutStatus {
    PENDING
    PAID
}

enum ReturnStatus {
    REQUESTED
    APPROVED
    REJECTED
    COMPLETED
}

// Required for creating an Order: total, userId, storeId, addressId, isPaid, paymentMethod, paymentStatus, isCouponUsed, coupon (JSON), orderItems (nested)
model Order {
    id            String        @id @default(cuid())
    total         Float
    status        OrderStatus   @default(ORDER_PLACED)
    userId        String
    storeId       String
    addressId     String
    isPaid        Boolean       @default(false)
    paymentMethod PaymentMethod
    paymentStatus PaymentStatus @default(PENDING)
    paymentExpiresAt DateTime?
    paymentProofUrl String?
    paymentProofStatus PaymentProofStatus @default(NOT_SUBMITTED)
    paymentProofNotes String?
    paymentProofDate DateTime?
    paymentReviewedBy String?
    paymentReviewedAt DateTime?
    paymentReceivedAt DateTime?
    // Persisted shipping cost applied to this order
    shippingCost  Float?        @default(0)
    // Reference to the shipping rule applied (if any)
    shippingRuleId String?
    // Commission breakdown stored as JSON per-item
    commission     Json          @default("{}")
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt
    isCouponUsed  Boolean       @default(false)
    coupon        Json          @default("{}")
    // Invoice request fields
    invoiceRequested   Boolean   @default(false)
    invoiceRequestedAt DateTime?
    invoiceStatus      String?   // null | "SENT"
    invoiceSentAt      DateTime?
    orderItems    OrderItem[]

    // Relations
    user    User    @relation("BuyerRelation", fields: [userId], references: [id])
    store   Store   @relation(fields: [storeId], references: [id])
    address Address @relation(fields: [addressId], references: [id])
    conversations Conversation[]
    returnRequest Return?

    @@index([paymentProofStatus, createdAt])
}

// Required for creating an OrderItem: orderId, productId, quantity, price
model OrderItem {
    orderId   String
    productId String
    quantity  Int
    price     Float

    // Relations
    order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id])

    @@id([orderId, productId])
}

// Required for creating a Rating: rating, review, userId, productId
model Rating {
    id        String   @id @default(cuid())
    rating    Int
    review    String
    userId    String
    productId String
    orderId   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@unique([userId, productId, orderId])
}

// Required for creating an Address: userId, name, email, street, city, state, zip, country, phone
model Address {
    id        String   @id @default(cuid())
    userId    String
    name      String
    email     String
    street    String
    city      String
    state     String
    zip       String
    country   String
    phone     String
    // Optional geolocation for distance-based shipping
    latitude  Float?
    longitude Float?
    // Optional district/region identifier for region-based shipping
    district  String?
    // Kigali sector for zone-based shipping (Zone A/B/C)
    sector    String?
    createdAt DateTime @default(now())

    // Relations
    Order Order[]
    user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Required for creating a Coupon: code, description, discount, forNewUser, isPublic, expiresAt
model Coupon {
    code        String   @id
    description String
    discount    Float
    forNewUser  Boolean
    isPublic    Boolean
    expiresAt   DateTime
    maxUses     Int?
    usedCount   Int      @default(0)
    createdAt   DateTime @default(now())
}

// Required for creating a Store: userId, name, username, email, contact, logo, description, address (optional: , status, isActive)
model Store {
    id          String   @id @default(cuid())
    userId      String   @unique
    name        String
    description String
    username    String   @unique
    address     String
    status          String   @default("pending")
    isActive        Boolean  @default(false)
    rejectionNotes  String?
    logo        String
    email       String
    contact     String
    sellerModel SellerModel @default(LOCAL_SELLER)
    tinNumber   String?
    idPhotoUrl  String?
    rdbCertificateUrl String?
    // Optional geolocation for distance calculations
    latitude    Float?
    longitude   Float?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    Product Product[]
    Order   Order[]
    conversations Conversation[]
    user    User      @relation(fields: [userId], references: [id])
    payouts Payout[]
}

model Conversation {
    id           String                 @id @default(cuid())
    targetType   ConversationTargetType
    storeId      String?
    orderId      String?
    createdById  String
    createdAt    DateTime               @default(now())
    updatedAt    DateTime               @updatedAt

    store        Store?                 @relation(fields: [storeId], references: [id])
    order        Order?                 @relation(fields: [orderId], references: [id])
    participants ConversationParticipant[]
    messages     Message[]

    @@index([targetType, createdAt])
}

model ConversationParticipant {
    conversationId String
    userId         String
    createdAt      DateTime @default(now())

    conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([conversationId, userId])
    @@index([userId, createdAt])
}

model Message {
    id             String   @id @default(cuid())
    conversationId String
    senderId       String
    content        String
    createdAt      DateTime @default(now())
    isRead         Boolean  @default(false)

    conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

    @@index([conversationId, createdAt])
    @@index([senderId, createdAt])
}

enum SellerModel {
    FULL_MANAGED
    LOCAL_SELLER
}

enum ShippingRuleType {
    REGION
    KM
    DEFAULT
}

model ShippingRule {
    id        String           @id @default(cuid())
    name      String
    type      ShippingRuleType
    // For REGION rules this stores a district or region key
    regionKey String?
    // For KM rules define bounds
    minKm     Float?
    maxKm     Float?
    // Pricing
    flatRate  Float?
    perKmRate Float?
    priority  Int     @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// Weight-based shipping tariff table (zone × weight bracket)
// zone: "A" | "B" | "C" (Kigali last-mile) | "CHINA_RWANDA" (international freight)
model WeightShippingRate {
    id            String   @id @default(cuid())
    zone          String
    minWeightKg   Float
    maxWeightKg   Float?   // null = unlimited (100+ kg tier)
    cost          Float
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([zone, minWeightKg])
}

model CategoryCommission {
    id           String   @id @default(cuid())
    category     String
    sellerModel  String?  // "FULL_MANAGED" | "LOCAL_SELLER" | null (null = applies to all)
    percent      Float?   // percentage e.g., 5.5 for 5.5%
    fixedAmount  Float?   // fixed amount per item
    effectiveFrom DateTime?
    effectiveTo   DateTime?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([category, sellerModel])
}

model Return {
    id          String       @id @default(cuid())
    orderId     String       @unique
    userId      String
    reason      String
    status      ReturnStatus @default(REQUESTED)
    adminNotes  String?
    reviewedBy  String?
    reviewedAt  DateTime?
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    order       Order        @relation(fields: [orderId], references: [id])
    user        User         @relation(fields: [userId], references: [id])

    @@index([status, createdAt])
}

model Payout {
    id          String       @id @default(cuid())
    storeId     String
    amount      Float
    periodStart DateTime
    periodEnd   DateTime
    status      PayoutStatus @default(PENDING)
    paidAt      DateTime?
    paidBy      String?
    notes       String?
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    store       Store        @relation(fields: [storeId], references: [id])

    @@index([storeId, status])
}

model AuditLog {
    id         String   @id @default(cuid())
    adminId    String
    adminName  String   @default("")
    action     String
    targetType String
    targetId   String
    notes      String?
    metadata   Json     @default("{}")
    createdAt  DateTime @default(now())

    @@index([adminId, createdAt])
    @@index([targetType, createdAt])
}

// Raw event store for analytics / audit
model Event {
    id        String   @id @default(cuid())
    name      String
    payload   Json
    userId    String?
    storeId   String?
    createdAt DateTime @default(now())
}

// Admin-configurable payment method settings (single row, id = "default")
model PaymentConfig {
    id                String   @id @default("default")
    momoPayCode       String?
    momoAccountName   String?
    bankName          String?
    bankAccountNumber String?
    bankAccountName   String?
    bankBranch        String?
    updatedAt         DateTime @updatedAt
}

// Admin-configurable hero/banner slots ("main" | "card1" | "card2")
model HeroConfig {
    slot          String   @id  // "main" | "card1" | "card2"
    // Main panel
    badgeText     String?
    headline      String?
    description   String?
    startingPrice String?
    cta1Label     String?
    cta1Href      String?
    cta2Label     String?
    cta2Href      String?
    // Side cards
    cardTitle     String?
    accentColor   String?  // hex e.g. "#FFAD51"
    linkLabel     String?
    linkHref      String?
    // Shared
    imageUrl      String?
    updatedAt     DateTime @updatedAt
}
