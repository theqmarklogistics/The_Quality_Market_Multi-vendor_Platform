generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

// Required for creating a User: id, name, email, image, cart (optional JSON string)
model User {
    id    String @id
    name  String
    email String
    image String
    role  UserRole @default(CUSTOMER)
    cart  Json   @default("{}")
    // Account credit earned from pooled-delivery savings (external partners),
    // redeemable against future delivery bookings.
    deliveryCreditBalance Float @default(0)
    // Admin deactivation flag — sign-in is blocked via a Clerk ban; this flag
    // drives the admin UI and lets staff-facing queries exclude the account.
    isActive Boolean @default(true)

    // Relations
    ratings     Rating[]
    Address     Address[]
    store       Store?
    buyerOrders Order[]   @relation("BuyerRelation")
    conversations      ConversationParticipant[]
    sentMessages       Message[]                 @relation("MessageSender")
    returns     Return[]
    riderProfile       RiderProfile?
    staffProfile       StaffProfile?
    assignedCorridors  DeliveryCorridor[]        @relation("CorridorRider")
    corridorSchedules  CorridorSchedule[]        @relation("ScheduleRider")
    pushTokens         PushToken[]
}

// Expo push notification tokens, one row per device. Used by the mobile app to
// deliver delivery-status (and other) push notifications alongside Resend email.
model PushToken {
    id        String   @id @default(cuid())
    userId    String
    token     String   @unique
    platform  String?  // "ios" | "android"
    deviceId  String?  // stable per-install id, for de-duping a device's token
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// Required for creating a Product: name, description, mrp, price, images, category, storeId
model Product {
    id          String   @id @default(cuid())
    name        String
    description String
    mrp         Float
    price       Float
    warehouseQuantity Int @default(0)
    images      String[]
    category    String
    inStock     Boolean  @default(true)
    storeId     String
    approvalStatus ProductApprovalStatus @default(PENDING)
    approvalNotes  String?
    approvedBy     String?
    approvedAt     DateTime?
    // Wholesale pricing (optional — unlocked when quantity >= wholesaleMinQty)
    wholesalePrice  Float?
    wholesaleMinQty Int?
    // Shipping dimensions for weight-based cost calculation
    weightKg    Float?
    lengthCm    Float?
    widthCm     Float?
    heightCm    Float?
    importOrigin String?  // "CHINA" | null (local/Rwanda)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations
    store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
    orderItems OrderItem[]
    rating     Rating[]

    @@index([approvalStatus, createdAt])
}

enum ProductApprovalStatus {
    PENDING
    APPROVED
    REJECTED
}

enum OrderStatus {
    ORDER_PLACED
    PROCESSING
    SHIPPED
    DELIVERED
    OTHER
}

enum DeliveryType {
    STANDARD_UNPOOLED
    KIGALI_POOL
    // Instant dispatch: skips the pooled batching schedule — a single-stop
    // EXPRESS run is created on the dispatch board the moment it's booked/paid.
    EXPRESS
}

enum IntakeMethod {
    HUB_DROP_OFF
    DRIVER_SWEEP
}

enum PoolDeliveryStatus {
    PENDING_INTAKE
    SORTING
    IN_TRANSIT
    ARRIVING
    DELIVERED
    FAILED
}

enum EscrowStatus {
    NOT_HELD
    HELD
    RELEASED
    REFUNDED
}

enum CorridorStatus {
    OPEN
    CLOSED
    IN_TRANSIT
    COMPLETED
}

enum PaymentMethod {
    STRIPE
    MTN_MOMO
    AIRTEL_MONEY
    BANK_TRANSFER
    EKASH
}

enum PaymentStatus {
    PENDING
    PAID
    FAILED
    EXPIRED
    CANCELLED
}

enum PaymentProofStatus {
    NOT_SUBMITTED
    SUBMITTED
    APPROVED
    REJECTED
}

enum ConversationTargetType {
    ADMIN
    STORE
}

enum PayoutStatus {
    PENDING
    PAID
}

enum ReturnStatus {
    REQUESTED
    APPROVED
    REJECTED
    COMPLETED
}

// Required for creating an Order: total, userId, storeId, addressId, isPaid, paymentMethod, paymentStatus, isCouponUsed, coupon (JSON), orderItems (nested)
model Order {
    id            String        @id @default(cuid())
    total         Float
    status        OrderStatus   @default(ORDER_PLACED)
    userId        String
    // Nullable: external (off-platform) delivery-only orders have no platform store.
    storeId       String?
    addressId     String
    isPaid        Boolean       @default(false)
    paymentMethod PaymentMethod
    paymentStatus PaymentStatus @default(PENDING)
    paymentExpiresAt DateTime?
    paymentProofUrl String?
    paymentProofStatus PaymentProofStatus @default(NOT_SUBMITTED)
    paymentProofNotes String?
    paymentProofDate DateTime?
    paymentReviewedBy String?
    paymentReviewedAt DateTime?
    paymentReceivedAt DateTime?
    // Persisted shipping cost applied to this order
    shippingCost  Float?        @default(0)
    // Whether the shipping fee has been confirmed (false = seller still needs to set it for LOCAL_SELLER)
    shippingQuoted Boolean      @default(false)
    // True when the package weight fell outside every configured DeliveryWeightRange,
    // so the fee could not be auto-computed — admin must contact the customer and set it.
    shippingNeedsReview Boolean  @default(false)
    // Reference to the shipping rule applied (if any)
    shippingRuleId String?
    // Commission breakdown stored as JSON per-item
    commission     Json          @default("{}")
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt
    isCouponUsed  Boolean       @default(false)
    coupon        Json          @default("{}")
    // Invoice request fields
    invoiceRequested   Boolean   @default(false)
    invoiceRequestedAt DateTime?
    invoiceStatus      String?   // null | "SENT"
    invoiceSentAt      DateTime?
    publicStatusNote   String?
    customStatusLabel  String?
    // Kigali Pooled Delivery fields
    deliveryType      DeliveryType       @default(STANDARD_UNPOOLED)
    intakeMethod      IntakeMethod?
    landmarkAddress   String?
    deliveryStatus    PoolDeliveryStatus?
    deliveryOtp       String?
    escrowStatus      EscrowStatus       @default(NOT_HELD)
    deliveryFeeShare  Float?
    corridorId        String?
    // Contact phone confirmed at checkout (may differ from the saved address phone)
    contactPhone      String?
    // Realtime tracking: customer pinned/live location (kept on the order, not the saved Address)
    recipientLat      Float?
    recipientLng      Float?
    locationSharedAt  DateTime?
    // Explicit position within the corridor route
    stopSequence      Int?
    // Hub→drop road distance (km), computed once at corridor build/assignment
    // and persisted so rider batches sort nearest-first without recomputing.
    deliveryDistanceKm Float?
    deliveredAt       DateTime?
    failureReason     String?
    // Number of completed (failed) delivery attempts for this pooled order
    deliveryAttempts  Int                @default(0)
    // OTP verification hardening — throttles brute-force on the 4-digit code
    otpAttempts       Int                @default(0)
    otpLockedUntil    DateTime?
    // ── External-seller delivery (off-platform merchant uses our delivery only) ──
    // True when this is a delivery-only order with no platform store/products.
    isExternalDelivery Boolean           @default(false)
    // Package sender — who is sending the package (shown on delivery documents).
    senderName         String?
    senderPhone        String?
    senderEmail        String?
    // Pickup details — where the rider (or sweep) collects the package.
    pickupContactName  String?
    pickupPhone        String?
    pickupLandmark     String?
    pickupLat          Float?
    pickupLng          Float?
    packageDescription String?
    declaredValue      Float?
    // Package weight/dimensions for distance+weight pricing (external delivery-only
    // orders; platform orders derive weight from their products instead).
    packageWeightKg    Float?
    packageLengthCm    Float?
    packageWidthCm     Float?
    packageHeightCm    Float?
    // Pooling credit: `poolingSavings` (total − deliveryFeeShare) is returned to the
    // partner as account credit on delivery; `creditApplied` is credit redeemed at
    // booking to reduce the cash due.
    poolingSavings     Float?
    creditApplied      Float?            @default(0)
    // Unguessable token for the public (no-login) recipient tracking link.
    trackingToken      String?           @unique
    // Proof-of-delivery photo — fallback confirmation when the recipient can't
    // provide the OTP (rider captures a photo at the door instead).
    podPhotoUrl        String?
    orderItems    OrderItem[]

    // Relations
    user    User    @relation("BuyerRelation", fields: [userId], references: [id])
    store   Store?  @relation(fields: [storeId], references: [id])
    address Address @relation(fields: [addressId], references: [id])
    conversations Conversation[]
    returnRequest Return?
    corridor      DeliveryCorridor? @relation(fields: [corridorId], references: [id])
    invoice       Invoice?

    @@index([paymentProofStatus, createdAt])
    // Rider batch listing: stops of a corridor sorted nearest-first.
    @@index([corridorId, deliveryDistanceKm])
}

// Sequential, race-safe invoice issued the moment a Bank Transfer order is
// placed (proforma — before payment confirmation). `invoiceNumber` is drawn from
// the Postgres sequence `invoice_number_seq` (single-statement nextval, so
// concurrent checkouts can never collide); `paymentReference` is the formatted
// number (INV-YYYY-00042) the customer must quote on the transfer. `snapshot`
// freezes everything the PDF needs (items, bank details, customer, address) so
// the document stays reproducible even if the order changes later.
model Invoice {
    id               String   @id @default(cuid())
    invoiceNumber    Int      @unique
    paymentReference String   @unique
    orderId          String   @unique
    subtotal         Float
    shippingFee      Float    @default(0)
    discount         Float    @default(0)
    total            Float
    chargeableKg     Float?
    shippingTier     String?
    snapshot         Json     @default("{}")
    issuedAt         DateTime @default(now())

    order Order @relation(fields: [orderId], references: [id])

    @@index([issuedAt])
}

// Required for creating an OrderItem: orderId, productId, quantity, price
model OrderItem {
    orderId   String
    productId String
    quantity  Int
    price     Float

    // Relations
    order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id])

    @@id([orderId, productId])
}

// Required for creating a Rating: rating, review, userId, productId
model Rating {
    id        String   @id @default(cuid())
    rating    Int
    review    String
    userId    String
    productId String
    orderId   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@unique([userId, productId, orderId])
}

// Required for creating an Address: userId, name, email, street, city, state, zip, country, phone
model Address {
    id        String   @id @default(cuid())
    userId    String
    name      String
    email     String
    street    String
    city      String
    state     String
    zip       String
    country   String
    phone     String
    // Optional geolocation for distance-based shipping
    latitude  Float?
    longitude Float?
    // Optional district/region identifier for region-based shipping
    district  String?
    // Kigali sector for zone-based shipping (Zone A/B/C)
    sector    String?
    // Cell — every recorded address goes down to at least this level.
    cell      String?
    // Village-level detail (umudugudu) — finest administrative detail; also used
    // to geocode an approximate location when GPS isn't shared/pinned.
    village   String?
    createdAt DateTime @default(now())

    // Relations
    Order Order[]
    user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Required for creating a Coupon: code, description, discount, forNewUser, isPublic, expiresAt
model Coupon {
    code        String   @id
    description String
    discount    Float
    forNewUser  Boolean
    isPublic    Boolean
    expiresAt   DateTime
    maxUses     Int?
    usedCount   Int      @default(0)
    createdAt   DateTime @default(now())
}

// Required for creating a Store: userId, name, username, email, contact, logo, description, address (optional: , status, isActive)
model Store {
    id          String   @id @default(cuid())
    userId      String   @unique
    name        String
    description String
    username    String   @unique
    address     String
    status          String   @default("pending")
    isActive        Boolean  @default(false)
    rejectionNotes  String?
    archivedAt      DateTime?
    logo        String
    email       String
    contact     String
    sellerModel SellerModel @default(LOCAL_SELLER)
    tinNumber   String?
    idPhotoUrl  String?
    rdbCertificateUrl String?
    // Optional geolocation for distance calculations
    latitude    Float?
    longitude   Float?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    Product Product[]
    Order   Order[]
    conversations Conversation[]
    user    User      @relation(fields: [userId], references: [id])
    payouts Payout[]
}

model Conversation {
    id           String                 @id @default(cuid())
    targetType   ConversationTargetType
    storeId      String?
    orderId      String?
    createdById  String
    createdAt    DateTime               @default(now())
    updatedAt    DateTime               @updatedAt

    store        Store?                 @relation(fields: [storeId], references: [id])
    order        Order?                 @relation(fields: [orderId], references: [id])
    participants ConversationParticipant[]
    messages     Message[]

    @@index([targetType, createdAt])
}

model ConversationParticipant {
    conversationId String
    userId         String
    createdAt      DateTime @default(now())

    conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([conversationId, userId])
    @@index([userId, createdAt])
}

model Message {
    id             String   @id @default(cuid())
    conversationId String
    senderId       String
    content        String
    createdAt      DateTime @default(now())
    isRead         Boolean  @default(false)

    conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

    @@index([conversationId, createdAt])
    @@index([senderId, createdAt])
}

enum SellerModel {
    FULL_MANAGED
    LOCAL_SELLER
}

enum UserRole {
    CUSTOMER
    ADMIN
    SELLER
    LOGISTICS_MANAGER
    FINANCIAL_OPERATIONAL
    WAREHOUSE_KEEPER
    RIDER
    EXTERNAL_SELLER
    AGENT
}

enum ShippingRuleType {
    REGION
    KM
    DEFAULT
}

model ShippingRule {
    id        String           @id @default(cuid())
    name      String
    type      ShippingRuleType
    // For REGION rules this stores a district or region key
    regionKey String?
    // For KM rules define bounds
    minKm     Float?
    maxKm     Float?
    // Pricing
    flatRate  Float?
    perKmRate Float?
    priority  Int     @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// Weight-based shipping tariff table (zone × weight bracket)
// zone: "A" | "B" | "C" (Kigali last-mile) | "CHINA_RWANDA" (international freight)
model WeightShippingRate {
    id            String   @id @default(cuid())
    zone          String
    minWeightKg   Float
    maxWeightKg   Float?   // null = unlimited (100+ kg tier)
    cost          Float
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([zone, minWeightKg])
}

model CategoryCommission {
    id           String   @id @default(cuid())
    category     String
    sellerModel  String?  // "FULL_MANAGED" | "LOCAL_SELLER" | null (null = applies to all)
    percent      Float?   // percentage e.g., 5.5 for 5.5%
    fixedAmount  Float?   // fixed amount per item
    effectiveFrom DateTime?
    effectiveTo   DateTime?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([category, sellerModel])
}

model Return {
    id          String       @id @default(cuid())
    orderId     String       @unique
    userId      String
    reason      String
    status      ReturnStatus @default(REQUESTED)
    adminNotes  String?
    reviewedBy  String?
    reviewedAt  DateTime?
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    order       Order        @relation(fields: [orderId], references: [id])
    user        User         @relation(fields: [userId], references: [id])

    @@index([status, createdAt])
}

model Payout {
    id          String       @id @default(cuid())
    storeId     String
    amount      Float
    periodStart DateTime
    periodEnd   DateTime
    status      PayoutStatus @default(PENDING)
    paidAt      DateTime?
    paidBy      String?
    notes       String?
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    store       Store        @relation(fields: [storeId], references: [id])

    @@index([storeId, status])
}

model AuditLog {
    id         String   @id @default(cuid())
    adminId    String
    adminName  String   @default("")
    action     String
    targetType String
    targetId   String
    notes      String?
    metadata   Json     @default("{}")
    createdAt  DateTime @default(now())

    @@index([adminId, createdAt])
    @@index([targetType, createdAt])
}

// Raw event store for analytics / audit
model Event {
    id        String   @id @default(cuid())
    name      String
    payload   Json
    userId    String?
    storeId   String?
    createdAt DateTime @default(now())
}

// Admin-configurable payment method settings (single row, id = "default")
model PaymentConfig {
    id                String   @id @default("default")
    momoPayCode       String?
    momoAccountName   String?
    bankName          String?
    bankAccountNumber String?
    bankAccountName   String?
    bankBranch        String?
    ekashNumber       String?
    ekashAccountName  String?
    updatedAt         DateTime @updatedAt
}

// Admin-configurable pricing for external-seller (off-platform) deliveries.
// Single row (id = "default"). `basePrice` is the published flat fee charged to
// the partner at booking; `perSector` optionally overrides it per Kigali sector
// ({ "Kimironko": 2500, ... }). This is the CUSTOMER price and is independent of
// the internal proportional `deliveryFeeShare` used to pay the rider.
model ExternalDeliveryConfig {
    id        String   @id @default("default")
    basePrice Float    @default(2000)
    perSector Json     @default("{}")
    // Segmented distance-taper pricing knobs (admin-tunable). See lib/deliveryPricing.js:
    //   effectiveDist = Σ per taperStepKm segment: segLen × max(taperFloorPct, 1 − i × taperDropPerStep)
    //   fee           = max(minimumFloor, round(baseRatePerKgKm × chargeableWeight × effectiveDist))
    // where chargeableWeight is the DeliveryWeightRange value for max(actual, volumetric) kg.
    baseRatePerKgKm  Float  @default(8)      // RWF per km · chargeable-weight unit
    // EXPRESS deliveries use the same formula but with their own (higher) base
    // rate — the only pricing knob that differs from normal delivery.
    expressBaseRatePerKgKm Float @default(16) // RWF per km · chargeable-weight unit (express)
    // Admin kill-switch: when false, Express is hidden at checkout/booking and
    // the APIs reject new express orders (existing ones still dispatch/deliver).
    expressEnabled         Boolean @default(true)
    minimumFloor     Float  @default(2000)   // RWF global floor for short/light trips
    volumetricFactor Float  @default(200)    // kg per 1 m³ (1 CBM = 200 kg)
    taperStepKm      Float  @default(5)      // km per taper step
    taperDropPerStep Float  @default(0.10)   // fractional rate reduction per step (10%)
    taperFloorPct    Float  @default(0.50)   // minimum multiplier the taper decays to (50%)
    updatedAt DateTime @updatedAt
}

// Admin-defined weight ranges mapping a kg bracket to the CHARGEABLE weight value
// used in the shipping-fee formula. The greater of the package's actual vs
// volumetric weight is looked up here; a value outside every range flags the
// order for manual review (admin contacts the customer). maxWeightKg = null is
// the open top tier.
model DeliveryWeightRange {
    id           String   @id @default(cuid())
    minWeightKg  Float
    maxWeightKg  Float?
    chargeableKg Float
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([minWeightKg])
}

// Admin-configurable announcement banner (single row, id = "default")
model BannerConfig {
    id         String   @id @default("default")
    isActive   Boolean  @default(false)
    text       String   @default("Get 20% OFF on your first order with code NEW20.")
    couponCode String?  @default("NEW20")
    updatedAt  DateTime @updatedAt
}

// Admin-managed product categories. Nestable up to 3 levels
// (category → subcategory → sub-subcategory); the depth limit is enforced in
// the admin API. Names stay globally unique because products reference their
// category by name (Product.category string).
model Category {
    id                String   @id @default(cuid())
    name              String   @unique
    commissionPercent Float    @default(0)
    isActive          Boolean  @default(true)
    sortOrder         Int      @default(0)
    parentId          String?
    parent            Category?  @relation("CategoryTree", fields: [parentId], references: [id])
    children          Category[] @relation("CategoryTree")
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([parentId])
}

// Newsletter subscribers
model NewsletterSubscriber {
    id               String    @id @default(cuid())
    email            String    @unique
    subscribedAt     DateTime  @default(now())
    unsubscribedAt   DateTime?
    unsubscribeToken String    @unique @default(cuid())
    resendContactId  String?
}

model DeliveryCorridor {
    id            String         @id @default(cuid())
    name          String
    runDate       DateTime
    baseRouteCost Float          @default(10000)
    status        CorridorStatus @default(OPEN)
    // Rider assignment + dispatch lifecycle
    assignedRiderId String?
    dispatchedAt    DateTime?
    completedAt     DateTime?
    // Last-known rider location snapshot (live ticks flow over socket; this seeds late-joiners)
    riderLat        Float?
    riderLng        Float?
    riderLocationAt DateTime?
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    orders        Order[]
    assignedRider User?          @relation("CorridorRider", fields: [assignedRiderId], references: [id])

    @@index([runDate, status])
}

// Public-facing staff contact card (AGENT / LOGISTICS_MANAGER). Admin-managed;
// published on the public delivery-network page so senders can reach the
// nearest agent (or the logistics manager) directly by phone.
model StaffProfile {
    id        String   @id @default(cuid())
    userId    String   @unique
    phone     String?
    // Where this staff member is stationed
    sector    String?
    landmark  String?
    latitude  Float?
    longitude Float?
    // Whether this card is shown on the public delivery-network page
    isPublic  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Rider/driver profile used by the dispatch board to assign deliveries
model RiderProfile {
    id          String   @id @default(cuid())
    userId      String   @unique
    phone       String?
    vehicleType String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Physical drop-off / dispatch hub. Admin-managed; corridors depart from a hub.
model DeliveryHub {
    id        String   @id @default(cuid())
    name      String
    sector    String?
    landmark  String?
    latitude  Float?
    longitude Float?
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    corridorRoutes CorridorRoute[]
}

// Admin-registered corridor (a named route/area served from a hub). These are the
// building blocks for the public rider schedule; daily DeliveryCorridor runs are
// still created on the dispatch board.
model CorridorRoute {
    id          String   @id @default(cuid())
    name        String
    hubId       String
    description String?
    // Areas/sectors this corridor passes through (free-form labels)
    areas       String[] @default([])
    // Ordered landmarks the rider passes on this route, recorded from the
    // beginning of the corridor to its end (array order IS the route order).
    landmarks   String[] @default([])
    // Optional lane pricing: a fixed fee for any drop in this corridor's areas,
    // or a per-km rate on the road distance. Fixed wins when both are set.
    // When either is set, it overrides the formula/strategy fee for matching drops.
    fixedRate   Float?
    perKmRate   Float?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    hub       DeliveryHub        @relation(fields: [hubId], references: [id], onDelete: Cascade)
    schedules CorridorSchedule[]

    @@index([hubId, isActive])
}

// Recurring public schedule entry: a rider departs a hub along a corridor on a
// weekday at a set time. Shown publicly so senders know when to drop packages.
model CorridorSchedule {
    id              String   @id @default(cuid())
    corridorRouteId String
    // 0 = Sunday … 6 = Saturday
    dayOfWeek       Int
    departTime      String   // "HH:mm" 24h local time
    riderId         String?
    isActive        Boolean  @default(true)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    corridorRoute CorridorRoute @relation(fields: [corridorRouteId], references: [id], onDelete: Cascade)
    rider         User?         @relation("ScheduleRider", fields: [riderId], references: [id])

    @@index([corridorRouteId, dayOfWeek])
}

enum EmailDirection {
    INBOUND
    OUTBOUND
}

// Admin ↔ customer EMAIL conversation (distinct from the in-app Conversation/
// Message chat). Outbound mail sets Reply-To to inbox+<token>@INBOUND_EMAIL_DOMAIN;
// the Resend inbound webhook (/api/email/inbound) matches replies back to the
// thread by that token (falling back to the References/In-Reply-To headers).
model EmailThread {
    id            String   @id @default(cuid())
    token         String   @unique @default(cuid())
    subject       String
    customerEmail String
    userId        String?
    orderId       String?
    lastMessageAt DateTime @default(now())
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    messages EmailMessage[]

    @@index([customerEmail])
    @@index([lastMessageAt])
}

model EmailMessage {
    id                String         @id @default(cuid())
    threadId          String
    direction         EmailDirection
    fromEmail         String
    toEmail           String
    subject           String?
    bodyText          String?
    bodyHtml          String?
    // Resend message id (outbound) / RFC-5322 Message-ID (inbound) — used to
    // match replies via their References / In-Reply-To headers.
    providerMessageId String?
    sentById          String? // admin user id, outbound only
    isRead            Boolean        @default(false)
    createdAt         DateTime       @default(now())

    thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

    @@index([threadId, createdAt])
    @@index([providerMessageId])
}

// Geocoding results cached by normalized address string ("village|sector|district|province")
// so repeat lookups of the same Rwandan address never re-bill the Google Geocoding API.
model GeocodeCache {
    id        String   @id @default(cuid())
    query     String   @unique
    lat       Float
    lng       Float
    precision String? // "village" | "sector" | "district"
    provider  String? // "google" | "nominatim"
    createdAt DateTime @default(now())
}

// Road-network route distances cached by rounded origin/destination coords
// (4 dp ≈ 11 m) so repeat quotes for the same lane never re-bill the Google
// Routes API. `provider` records which backend produced the figure.
model RouteCache {
    id         String   @id @default(cuid())
    key        String   @unique // "lat,lng->lat,lng" rounded to 4 dp
    distanceKm Float
    durationMin Float?
    provider   String // "google" | "osrm" | "haversine"
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

// Admin-configurable hero/banner slots ("main" | "card1" | "card2")
model HeroConfig {
    slot          String   @id  // "main" | "card1" | "card2"
    // Main panel
    badgeText     String?
    headline      String?
    description   String?
    startingPrice String?
    cta1Label     String?
    cta1Href      String?
    cta2Label     String?
    cta2Href      String?
    // Side cards
    cardTitle     String?
    accentColor   String?  // hex e.g. "#FFAD51"
    linkLabel     String?
    linkHref      String?
    // Shared
    imageUrl      String?
    updatedAt     DateTime @updatedAt
}
